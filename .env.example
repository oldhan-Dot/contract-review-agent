# Copy to .env; scripts/setup.ps1 generates local database passwords.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=dev
LOG_LEVEL=INFO
DATA_DIR=./data

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=contract_review
MYSQL_USER=cra
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_IMAGE=mysql:8.0.36
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# Enable only after configuring your real model endpoint and key.
# Disabled mode starts only the environment scaffold, not an AI review service.
LLM_ENABLED=0
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_NAME=deepseek-flash
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=1
LLM_CONCURRENCY=4

OCR_ENABLED=0
OCR_BASE_URL=http://127.0.0.1:8100
OCR_API_KEY=
OCR_HEALTH_PATH=/health
OCR_TIMEOUT_SECONDS=90
OCR_MIN_AVG_CONFIDENCE=0.85
OCR_RENDER_DPI=200

APPROVAL_MODE=mock
APPROVAL_BASE_URL=http://127.0.0.1:8000
APPROVAL_TIMEOUT_SECONDS=15
APPROVAL_MAX_RETRY=3
MOCK_APPROVAL_PUSH_ENABLED=1
MAX_UPLOAD_MB=50
TASK_CONCURRENCY=5
TASK_TIMEOUT_SECONDS=480
